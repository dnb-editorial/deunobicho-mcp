  },
  "bugs": {
    "url": "https://github.com/athos-alexandre/deunobicho-mcp/issues"
  },
  "author": "Athos Alexandre <editorial@deunobicho.online> (https://deunobicho.online)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
